# Copy to .env  (never commit .env)
ANTHROPIC_API_KEY=your_key_here
MODEL=claude-sonnet-5-5
PORT=3000
# For local development, use a service-account file:
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# On Vercel, set FIREBASE_SERVICE_ACCOUNT to the full service-account JSON instead.
# Never commit serviceAccount.json or put either credential in the Android app.
REQUIRE_AUTH=true
